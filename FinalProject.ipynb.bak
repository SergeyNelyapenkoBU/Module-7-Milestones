      "outputs": [],
      "source": [
        "## Configure\n",
        "checkpoint = \"distilbert-base-uncased\"\n",
        "MAX_LEN = 64\n",
        "BATCH = 128\n",
        "EPOCHS = 16\n",
        "LR = 2e-5           # small LR for partial fine-tuning\n",
        "WEIGHT_DECAY = 0.01\n",
        "WARMUP_RATIO = 0.1\n",
        "SUBSET_FRAC = 0.50  # fastest practical run; use 1.00 for final comparison\n",
        "\n",
        "es = tf_keras.callbacks.EarlyStopping(\n",
        "    monitor=\"val_loss\",\n",
        "    patience=2,\n",
        "    restore_best_weights=True\n",
        ")\n",
        "\n",
        "t0 = time.time()\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "tYmxHEEM1PtS"
      },
      "source": [
        "#### Speed subset on training only"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 14,
      "metadata": {
        "execution": {
          "iopub.execute_input": "2026-04-11T20:46:10.455870Z",
