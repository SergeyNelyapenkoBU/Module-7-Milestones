          "status": "completed"
        },
        "tags": []
      },
      "outputs": [],
      "source": [
        "\n",
        "\n",
        "subset_frac = 0.50\n",
        "n_train = len(X_train)\n",
        "subset_size = int(n_train * subset_frac)\n",
        "\n",
        "rng = np.random.default_rng(SEED)\n",
        "subset_idx = rng.choice(n_train, size=subset_size, replace=False)\n",
        "\n",
        "X_train_sub = X_train[subset_idx]\n",
        "y_train_sub = y_train[subset_idx]"
      ]
    },
