      "source": [
        "y_pred_distilbert = evaluate_model(\n",
        "    model=p4_model,\n",
        "    name=\"DistilBERT\",\n",
        "    X_te=test_ds,\n",
        "    y_te=y_test_final,\n",
        "    hist=history,\n",
        "    train_time=train_time,\n",
        "    batch_size=BATCH\n",
        ")"
      ]
